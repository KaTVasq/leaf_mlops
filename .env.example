# Copy to .env. The default needs no account, bucket or credentials.
STORAGE_BACKEND=local
MEDIA_ROOT=./data/media

# S3-compatible storage (MinIO for local testing, Cloudflare R2 or AWS S3 in production):
# STORAGE_BACKEND=s3
# S3_BUCKET=leaf-images
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_PREFIX=
